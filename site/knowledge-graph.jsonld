        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/concept/held-out-evaluation"
        }
      ],
      "schema:abstract": "Design an evaluation protocol aligned with a stated deployment target, identify leakage and selection-bias risks, interpret average precision and its limits, and justify an uncertainty procedure that respects the sampling structure.",
      "schema:description": "Defines a transfer exercise in experimental evaluation for a scientific-passage ranker: target estimand, dependence and grouping, leakage-safe model selection, average precision, calibration, uncertainty, and reproducibility. It is a protocol-design exercise, not a model implementation or benchmark report.",
      "schema:inLanguage": "en",
      "schema:learningResourceType": "experiment-guide",
      "schema:name": "Evaluating a model: from score to experimental protocol"
    },
