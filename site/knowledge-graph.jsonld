          "@language": "fr",
          "@value": "Mécanisme qui injecte ou expose l’information de position dans les calculs du modèle."
        },
        {
          "@language": "en",
          "@value": "Mechanism that injects or exposes positional information in model computations."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Encodage positionnel"
        },
        {
          "@language": "en",
          "@value": "Positional encoding"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/output-projection",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
