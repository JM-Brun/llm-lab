      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Key (clé)"
        },
        {
          "@language": "en",
          "@value": "Key"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/value",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/mathematical-tools-geometry"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Projection porteuse de l’information agrégée selon les poids d’attention."
