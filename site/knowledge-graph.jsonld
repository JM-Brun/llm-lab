      "schema:about": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/concept/dataset-curation"
        }
      ],
      "schema:abstract": "Build a traceable corpus-preparation protocol suited to a training or evaluation objective, avoid split leakage, and distinguish corpus-level decisions from tokenizer internals and training-example construction.",
      "schema:description": "Covers data-engineering decisions upstream of pretraining: source eligibility and provenance, parsing and filtering, deduplication, evaluation splits, tokenizer fitting/freezing, human annotation and label traceability, and hand-off to token streams.",
      "schema:inLanguage": "en",
      "schema:learningResourceType": "guided-build",
      "schema:name": "Preparing a corpus for pretraining"
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/en/cross-attention.html",
