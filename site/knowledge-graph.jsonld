      ],
      "schema:abstract": "Readers should distinguish context components, identify context failures, and propose controlled evaluations.",
      "schema:description": "Provides applied scenarios and answer criteria without repeating the conceptual lesson.",
      "schema:inLanguage": "en",
      "schema:learningResourceType": "exercise-hub",
      "schema:name": "Exercises — Context engineering"
