    {
      "@id": "https://jm-brun.github.io/llm-lab/en/contextualized-representations.html",
      "@type": [
        "schema:WebPage",
        "schema:LearningResource"
      ],
      "llmlab:editorialLevel": "core",
      "schema:about": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/concept/contextualized-representation"
        }
      ],
      "schema:abstract": "Readers should be able to explain why two occurrences of the same token share an initial embedding but can have different contextualized representations, and connect this difference to processing by Transformer layers.",
      "schema:description": "Explains how Transformer layers turn initial embeddings into context-dependent vectors and why the same ID can therefore have different contextualized states depending on position and context; distinguishes these states from the static vectors in the embedding table.",
      "schema:inLanguage": "en",
      "schema:learningResourceType": "concept-lesson",
      "schema:name": "Why can the same token have different contextualized representations?"
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/en/corpus-preparation.html",
      "@type": [
        "schema:WebPage",
