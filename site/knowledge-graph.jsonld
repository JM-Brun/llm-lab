    {
      "@id": "https://jm-brun.github.io/llm-lab/en/exercises-zipf-law.html",
      "@type": [
        "schema:WebPage",
        "schema:LearningResource"
      ],
      "llmlab:editorialLevel": "applied",
      "schema:about": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/concept/word-frequency-distribution"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/concept/zipf-law"
        }
      ],
      "schema:abstract": "Calculate, interpret, and critically assess rank-frequency regularities without confusing lexical statistics, token statistics, and causal explanations.",
