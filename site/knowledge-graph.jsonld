        }
      ],
      "schema:abstract": "Readers should be able to explain that a token ID is used as a row index/address in E, identify the vector stored in that row, and distinguish it from a contextualized state.",
      "schema:description": "Introduces embedding-matrix lookup, distinguishes a row address from vector coordinates, explains how the matrix is learned, and connects the lookup to contextualized representations. Code, exercises, references, and extended history are moved to Build, Practice, and Deepen.",
      "schema:inLanguage": "en",
      "schema:learningResourceType": "concept-lesson",
      "schema:name": "From token IDs to vectors: embeddings"
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/en/emergence.html",
      "@type": [
        "schema:WebPage",
        "schema:LearningResource"
      ],
      "llmlab:editorialLevel": "advanced",
      "schema:about": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/concept/emergent-ability"
        }
      ],
      "schema:abstract": "Readers should distinguish gradual improvement, a metric-induced success threshold, and a genuinely discontinuous transition, and identify the evidence needed to support an emergence claim.",
      "schema:description": "Examines emergent capabilities in language models, observations associated with scale, and the debate over whether they are discontinuous.",
      "schema:inLanguage": "en",
      "schema:learningResourceType": "concept-lesson",
      "schema:name": "Emergent capabilities: what changes with scale?"
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/en/entropy.html",
      "@type": [
        "schema:WebPage",
        "schema:LearningResource"
      ],
      "llmlab:editorialLevel": "core",
