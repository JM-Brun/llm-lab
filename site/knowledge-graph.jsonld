    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/token",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/text-tokenization"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Unité discrète produite par la tokenisation et consommée par le modèle."
        },
        {
          "@language": "en",
          "@value": "Discrete unit produced by tokenization and consumed by the model."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Token"
        },
        {
          "@language": "en",
          "@value": "Token"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/tokenizer",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/text-tokenization"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Système qui transforme du texte en séquences de tokens et d'identifiants selon une configuration donnée."
        },
        {
          "@language": "en",
          "@value": "System that transforms text into token and identifier sequences according to a defined configuration."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Tokenizer"
        },
        {
          "@language": "en",
          "@value": "Tokenizer"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/tokenization",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/text-tokenization"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Opération qui segmente ou représente un texte en unités discrètes consommées par un modèle."
        },
        {
          "@language": "en",
          "@value": "Operation that segments or represents text as discrete units consumed by a model."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Tokenisation"
        },
        {
          "@language": "en",
          "@value": "Tokenization"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/tokenizer-pipeline",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/text-tokenization"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Ensemble ordonné et configurable d'opérations qui transforment le texte en encodage, notamment normalisation, pré-tokenisation, modèle de segmentation et post-traitement."
        },
        {
          "@language": "en",
          "@value": "Ordered, configurable set of operations transforming text into an encoding, including normalization, pre-tokenization, segmentation model and post-processing."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Pipeline du tokenizer"
        },
        {
          "@language": "en",
          "@value": "Tokenizer pipeline"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/token-encoding",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/text-tokenization"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Application d'un tokenizer à un texte pour produire une séquence de tokens et leurs identifiants selon un vocabulaire et des conventions déterminés."
        },
        {
          "@language": "en",
          "@value": "Application of a tokenizer to text to produce a token sequence and its IDs according to a defined vocabulary and conventions."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Encodage des tokens"
        },
        {
          "@language": "en",
          "@value": "Token encoding"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/token-post-processing",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/text-tokenization"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Étape qui transforme l'encodage obtenu, par exemple en ajoutant des tokens de séquence ou des éléments structurants."
        },
        {
          "@language": "en",
          "@value": "Stage that transforms the resulting encoding, for example by adding sequence tokens or structural elements."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Post-traitement du tokenizer"
        },
        {
          "@language": "en",
          "@value": "Tokenizer post-processing"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/text-normalization",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/text-tokenization"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Transformation préalable du texte, par exemple de la casse, des espaces ou de la représentation Unicode, selon la configuration du tokenizer."
        },
        {
          "@language": "en",
          "@value": "Preliminary transformation of text, such as case, whitespace or Unicode representation, according to tokenizer configuration."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Normalisation du texte"
        },
        {
          "@language": "en",
          "@value": "Text normalization"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/pre-tokenization",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/text-tokenization"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Découpage ou transformation initiale du texte en segments qui contraignent les unités auxquelles s'applique le modèle de segmentation."
        },
        {
          "@language": "en",
          "@value": "Initial splitting or transformation of text into segments that constrain the units processed by the segmentation model."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Pré-tokenisation"
        },
        {
          "@language": "en",
          "@value": "Pre-tokenization"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/token-vocabulary",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/text-tokenization"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Ensemble des unités reconnues par un tokenizer, associées à des identifiants entiers."
        },
        {
          "@language": "en",
          "@value": "Set of units recognized by a tokenizer and associated with integer identifiers."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Vocabulaire du tokenizer"
        },
        {
          "@language": "en",
          "@value": "Tokenizer vocabulary"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/token-id",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/text-tokenization"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Identifiant entier d'une entrée du vocabulaire ; sa signification dépend du tokenizer et de son vocabulaire."
        },
        {
          "@language": "en",
          "@value": "Integer identifier for a vocabulary entry; its meaning depends on the tokenizer and its vocabulary."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Identifiant de token"
        },
        {
          "@language": "en",
          "@value": "Token ID"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/subword-tokenization",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/text-tokenization"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Famille de méthodes qui représente les textes à l'aide de fragments de mots appris ou définis par un vocabulaire."
        },
        {
          "@language": "en",
          "@value": "Family of methods representing text with word fragments learned or defined by a vocabulary."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Tokenisation en sous-mots"
        },
        {
          "@language": "en",
          "@value": "Subword tokenization"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/byte-pair-encoding",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/text-tokenization"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Méthode de construction d'un vocabulaire par fusions successives de paires adjacentes selon une règle de sélection."
        },
        {
          "@language": "en",
          "@value": "Vocabulary construction method based on successive merges of adjacent pairs according to a selection rule."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Byte Pair Encoding (BPE)"
        },
        {
          "@language": "en",
          "@value": "Byte Pair Encoding (BPE)"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/wordpiece",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/text-tokenization"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Méthode de segmentation en sous-mots utilisant un vocabulaire appris et une procédure de sélection et d'encodage propre à cette famille."
        },
        {
          "@language": "en",
          "@value": "Subword segmentation method using a learned vocabulary and family-specific selection and encoding procedures."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "WordPiece"
        },
        {
          "@language": "en",
          "@value": "WordPiece"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/unigram-tokenization",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/text-tokenization"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Approche probabiliste de segmentation en sous-mots fondée sur un modèle de tokens et une procédure de sélection de segmentation."
        },
        {
          "@language": "en",
          "@value": "Probabilistic subword segmentation approach based on a token model and a segmentation-selection procedure."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Tokenisation Unigram"
        },
        {
          "@language": "en",
          "@value": "Unigram tokenization"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/byte-level-encoding",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/text-tokenization"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Représentation initiale d'un texte par ses octets encodés, souvent UTF-8, avant d'éventuelles fusions en unités plus grandes."
        },
        {
          "@language": "en",
          "@value": "Initial representation of text using its encoded bytes, often UTF-8, before possible merges into larger units."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Encodage au niveau des octets"
        },
        {
          "@language": "en",
          "@value": "Byte-level encoding"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/special-token",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/text-tokenization"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Token réservé auquel le tokenizer ou le modèle attribue une fonction de contrôle ou de structure distincte du texte ordinaire."
        },
        {
          "@language": "en",
          "@value": "Reserved token assigned a control or structural role distinct from ordinary text."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Token spécial"
        },
        {
          "@language": "en",
          "@value": "Special token"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/token-decoding",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/text-tokenization"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Opération qui reconstruit une représentation textuelle à partir d'une séquence de tokens ou d'identifiants selon les conventions du tokenizer."
        },
        {
          "@language": "en",
          "@value": "Operation that reconstructs a text representation from a sequence of tokens or IDs according to tokenizer conventions."
        }
      ],
      "skos:inScheme": {
