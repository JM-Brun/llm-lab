          "@value": "Compatibilité du tokenizer"
        },
        {
          "@language": "en",
          "@value": "Tokenizer compatibility"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/tokenizer-evaluation",
      "@type": "skos:Concept",
