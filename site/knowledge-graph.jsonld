          "@language": "fr",
          "@value": "Décodage des tokens"
        },
        {
          "@language": "en",
          "@value": "Token decoding"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/tokenizer-training",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/text-tokenization"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Procédure qui apprend ou ajuste le vocabulaire et les paramètres d'un tokenizer à partir d'un corpus d'entraînement."
        },
        {
          "@language": "en",
          "@value": "Procedure that learns or fits a tokenizer vocabulary and parameters from a training corpus."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
