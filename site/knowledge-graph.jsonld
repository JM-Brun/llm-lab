      "schema:description": [
        {
          "@language": "fr",
          "@value": "Boucle autorégressive qui transforme les logits de la dernière position en sélection de token, l'ajoute au contexte et recommence."
        },
        {
          "@language": "en",
          "@value": "Autoregressive loop that turns the final-position logits into a token selection, appends it to the context, and repeats."
        }
