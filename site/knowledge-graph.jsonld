    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/token",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/text-tokenization"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Unité discrète produite par la tokenisation et consommée par le modèle."
        },
        {
          "@language": "en",
          "@value": "Discrete unit produced by tokenization and consumed by the model."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
