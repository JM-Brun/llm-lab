          "@value": "Entraînement d'un tokenizer"
        },
        {
          "@language": "en",
          "@value": "Tokenizer training"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/tokenizer-compatibility",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/text-tokenization"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Correspondance nécessaire entre le tokenizer, son vocabulaire, ses conventions d'encodage et les poids du modèle qui consomme ses identifiants."
        },
        {
          "@language": "en",
          "@value": "Required correspondence between a tokenizer, its vocabulary and encoding conventions, and the weights of the model consuming its IDs."
        }
