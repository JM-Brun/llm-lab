        },
        {
          "@language": "en",
          "@value": "Tokenizer evaluation"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/token-fertility",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/text-tokenization"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
