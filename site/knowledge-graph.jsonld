        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Évaluation des propriétés intrinsèques d'un tokenizer et de ses effets sur le coût et les performances du modèle en aval."
