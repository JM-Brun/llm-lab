        }
      ],
      "schema:abstract": "Advanced deep dive: formalize cross-attention, establish Q/K/V provenance and tensor dimensions, analyze masks, and place the mechanism in encoder–decoder and multimodal architectures.",
      "schema:description": "Explains cross-attention in encoder–decoder Transformers, distinguishing the sources of queries, keys, and values, dimensions, information flow, and possible masks.",
      "schema:inLanguage": "en",
      "schema:learningResourceType": "deep-dive",
      "schema:name": "Cross-attention: connecting two sequences"
    },
    {
