        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/concept/v-information"
        }
      ],
      "schema:abstract": "Calculate and interpret the entropy of a categorical next-token distribution, state its bounds for a finite vocabulary, and distinguish expected predictive uncertainty from the surprisal of an observed token.",
      "schema:description": "Define Shannon entropy of the model's next-token distribution for a fixed context as a measure of predictive dispersion before the next token is observed; distinguish it from the realized token's surprisal, sequence likelihood, and cross-entropy against a target distribution.",
      "schema:inLanguage": "en",
      "schema:learningResourceType": "concept-lesson",
      "schema:name": "Entropy: uncertainty over the next token"
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/en/experimental-evaluation.html",
      "@type": [
        "schema:WebPage",
        "schema:LearningResource"
      ],
      "llmlab:editorialLevel": "applied",
      "schema:about": [
        {
