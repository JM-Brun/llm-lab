          "@value": "Étape de décodage incrémental"
        },
        {
          "@language": "en",
          "@value": "Incremental decode step"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/kv-cache",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/inference-efficiency"
        }
      ],
      "llmlab:importance": "specialized",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Mécanisme d'inférence qui conserve les clés et valeurs déjà calculées afin d'éviter de recalculer le préfixe à chaque étape."
        },
        {
          "@language": "en",
          "@value": "Inference mechanism that retains previously computed keys and values to avoid recomputing the prefix at each step."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Cache clé-valeur (KV cache)"
        },
        {
          "@language": "en",
          "@value": "Key-value cache"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/generated-token-feedback",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/inference-efficiency"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Opération qui ajoute le token sélectionné au contexte afin que le calcul suivant conditionne sa prédiction sur ce token."
        },
        {
          "@language": "en",
          "@value": "Operation that appends the selected token to the context so the next computation conditions its prediction on that token."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Retour du token généré dans le contexte"
        },
        {
          "@language": "en",
          "@value": "Generated-token context feedback"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/training-example",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Paire ou séquence d'entrées et de cibles alignées qui permet de calculer les prédictions du prochain token et leur coût."
        },
        {
          "@language": "en",
          "@value": "Aligned input and target sequence or pair used to compute next-token predictions and their cost."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Exemple d'entraînement"
        },
        {
          "@language": "en",
          "@value": "Training example"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/teacher-forcing",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Stratégie qui fournit les tokens précédents observés comme contexte lors du calcul des prédictions d'entraînement, plutôt que les tokens générés par le modèle."
        },
        {
          "@language": "en",
          "@value": "Strategy that supplies observed previous tokens as context when computing training predictions, rather than tokens generated by the model."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Teacher forcing"
        },
        {
          "@language": "en",
          "@value": "Teacher forcing"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/loss-mask",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Sélectionne les positions cibles qui contribuent à la loss ; ne détermine pas quelles positions peuvent être utilisées comme contexte par l'attention."
        },
        {
          "@language": "en",
          "@value": "Selects target positions that contribute to the loss; it does not determine which positions attention may use as context."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Masque de perte"
        },
        {
          "@language": "en",
          "@value": "Loss mask"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/gradient",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/mathematical-tools-geometry"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Dérivée de l'objectif par rapport aux paramètres, indiquant localement comment l'objectif varie lorsque les paramètres changent."
        },
        {
          "@language": "en",
          "@value": "Derivative of the objective with respect to parameters, indicating locally how the objective changes as parameters change."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Gradient"
        },
        {
          "@language": "en",
          "@value": "Gradient"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/optimizer",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Algorithme qui utilise les gradients et son état interne pour calculer une mise à jour des paramètres."
        },
        {
          "@language": "en",
          "@value": "Algorithm that uses gradients and its internal state to compute a parameter update."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Optimiseur"
        },
        {
          "@language": "en",
          "@value": "Optimizer"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/parameter-update",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Modification des paramètres du modèle calculée par l'optimiseur à partir des gradients et de son état."
        },
        {
          "@language": "en",
          "@value": "Modification of model parameters computed by the optimizer from gradients and its state."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Mise à jour des paramètres"
        },
        {
          "@language": "en",
          "@value": "Parameter update"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/training-loop",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Répétition du cycle passe avant, loss, gradient et mise à jour des paramètres sur des batchs successifs, accompagnée de mesures sur des données de validation sans mise à jour."
        },
        {
          "@language": "en",
          "@value": "Repetition of the cycle of forward pass, loss, gradient and parameter update over successive batches, accompanied by measurements on validation data without updates."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Boucle d'entraînement"
        },
        {
          "@language": "en",
          "@value": "Training loop"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/overfitting",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Situation où la loss d'entraînement continue de baisser alors que la loss de validation cesse de s'améliorer ou remonte, signe d'un ajustement à des détails de l'échantillon d'entraînement."
        },
        {
          "@language": "en",
          "@value": "Situation where training loss keeps falling while validation loss stops improving or rises, indicating a fit to details of the training sample."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Surapprentissage"
        },
        {
          "@language": "en",
          "@value": "Overfitting"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/held-out-evaluation",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/scale-research"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Évaluation de prédictions sur des données qui n'ont pas servi à ajuster les paramètres, sans mise à jour de ceux-ci."
        },
        {
          "@language": "en",
          "@value": "Evaluation of predictions on data not used to fit parameters, without updating those parameters."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Évaluation sur données réservées"
        },
        {
          "@language": "en",
          "@value": "Held-out evaluation"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/in-context-learning",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/inference-efficiency"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Comportement par lequel un modèle adapte ses prédictions aux instructions, exemples ou régularités présents dans son contexte d'entrée, sans mise à jour de ses paramètres."
        },
        {
          "@language": "en",
          "@value": "Behavior in which a model adapts its predictions to instructions, examples, or patterns in its input context without updating its parameters."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Apprentissage en contexte"
        },
        {
          "@language": "en",
          "@value": "In-context learning"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/context-engineering",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/inference-efficiency"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Pratique d'ingénierie qui sélectionne, récupère, structure, hiérarchise, actualise et sécurise les informations fournies à un modèle pour une tâche donnée."
        },
        {
          "@language": "en",
          "@value": "Engineering practice that selects, retrieves, structures, prioritizes, updates, and secures the information supplied to a model for a given task."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Ingénierie du contexte"
        },
        {
          "@language": "en",
          "@value": "Context engineering"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/pretraining",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Phase d'entraînement initiale qui ajuste les paramètres du modèle sur un corpus à grande échelle selon un objectif prédéfini, souvent la prédiction du prochain token."
        },
        {
          "@language": "en",
          "@value": "Initial training phase that adjusts model parameters on a large corpus using a defined objective, often next-token prediction."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Pré-entraînement"
        },
        {
          "@language": "en",
          "@value": "Pretraining"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/post-training",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Ensemble de procédures appliquées après le pré-entraînement pour adapter le modèle à des instructions, préférences ou usages ciblés."
        },
        {
          "@language": "en",
          "@value": "Set of procedures applied after pretraining to adapt a model to instructions, preferences, or targeted uses."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Post-entraînement"
        },
        {
          "@language": "en",
          "@value": "Post-training"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/fine-tuning",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Adaptation d'un modèle pré-entraîné par une optimisation supplémentaire sur des données ou objectifs ciblés, qui modifie tout ou partie de ses paramètres."
        },
        {
          "@language": "en",
          "@value": "Adaptation of a pretrained model through additional optimization on targeted data or objectives, changing all or some of its parameters."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Fine-tuning (ajustement du modèle)"
        },
        {
          "@language": "en",
          "@value": "Fine-tuning"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/instruction-tuning",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Fine-tuning supervisé sur des exemples associant des instructions à des réponses attendues."
        },
        {
          "@language": "en",
          "@value": "Supervised fine-tuning on examples pairing instructions with expected responses."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Ajustement supervisé sur instructions"
        },
        {
          "@language": "en",
          "@value": "Instruction tuning"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/chat-template",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/text-tokenization"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Règle de sérialisation qui transforme des messages et leurs rôles, frontières et marqueurs de contrôle en une séquence de tokens conforme à la convention attendue par un modèle."
        },
        {
          "@language": "en",
          "@value": "Serialization rule that turns messages and their roles, boundaries, and control markers into a token sequence matching a model's expected convention."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Modèle de conversation (chat template)"
        },
        {
          "@language": "en",
          "@value": "Chat template"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/dataset-curation",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Processus de sélection, structuration, annotation, contrôle et documentation d'un jeu de données pour un usage défini."
        },
        {
          "@language": "en",
          "@value": "Process of selecting, structuring, annotating, checking, and documenting a dataset for a defined use."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Curation de jeux de données"
        },
        {
          "@language": "en",
          "@value": "Dataset curation"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/group-relative-policy-optimization",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "specialized",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Algorithme d'optimisation de politique pour lequel plusieurs réponses sont échantillonnées par prompt et leurs récompenses comparées au sein du groupe pour construire un avantage relatif ; la méthode originale évite un critique séparé."
        },
        {
          "@language": "en",
          "@value": "Policy-optimization algorithm that samples multiple responses per prompt and compares their rewards within the group to form a relative advantage; the original method avoids a separate critic."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Optimisation de politique relative au groupe (GRPO)"
        },
        {
          "@language": "en",
          "@value": "Group Relative Policy Optimization (GRPO)"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/reinforcement-learning-from-human-feedback",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Famille de méthodes qui utilisent des préférences ou évaluations humaines pour orienter l'optimisation du comportement d'un modèle."
        },
        {
          "@language": "en",
          "@value": "Family of methods using human preferences or evaluations to guide optimization of model behavior."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Apprentissage par renforcement à partir de retours humains"
        },
        {
          "@language": "en",
          "@value": "Reinforcement learning from human feedback"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/direct-preference-optimization",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "specialized",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Méthode d'optimisation qui ajuste directement une politique à partir de comparaisons de préférences, sans entraîner séparément un modèle de récompense dans sa formulation de base."
        },
        {
          "@language": "en",
          "@value": "Optimization method that directly adjusts a policy from preference comparisons, without separately training a reward model in its basic formulation."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Optimisation directe sur préférences"
        },
        {
          "@language": "en",
          "@value": "Direct preference optimization"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/inference-time-compute",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/inference-efficiency"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Ressources de calcul supplémentaires mobilisées pendant l'utilisation du modèle pour traiter une requête, rechercher ou vérifier une réponse."
        },
        {
          "@language": "en",
          "@value": "Additional compute resources used during model operation to process a request, search, or verify an answer."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Calcul à l'inférence"
        },
        {
          "@language": "en",
          "@value": "Inference-time compute"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/reasoning-model",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/inference-efficiency"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/scale-research"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Modèle ou variante entraînée et/ou configurée pour consacrer davantage de calcul à la résolution de problèmes nécessitant plusieurs étapes."
        },
        {
          "@language": "en",
          "@value": "Model or variant trained and/or configured to spend more compute on problems requiring multiple steps."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Modèle orienté raisonnement"
        },
        {
          "@language": "en",
          "@value": "Reasoning model"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/tool-calling",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/inference-efficiency"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Émission par le modèle d'une demande d'action structurée qu'une application ou un service externe peut exécuter."
        },
        {
          "@language": "en",
          "@value": "Model emission of a structured action request that an application or external service can execute."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Appel d'outil"
        },
        {
          "@language": "en",
          "@value": "Tool calling"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/agentic-system",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/inference-efficiency"
        }
      ],
      "llmlab:importance": "specialized",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Système qui poursuit un objectif au moyen d'une boucle de planification, d'utilisation d'outils, d'observation des résultats et d'ajustement."
        },
        {
          "@language": "en",
          "@value": "System that pursues a goal through a loop of planning, tool use, observing results, and adjustment."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Système agentique"
        },
        {
          "@language": "en",
          "@value": "Agentic system"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/policy-gradient",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Méthode d'optimisation d'une politique paramétrée qui utilise le gradient de la log-probabilité des actions échantillonnées, pondéré par un signal de récompense ou d'avantage."
        },
        {
          "@language": "en",
          "@value": "Method for optimizing a parameterized policy using gradients of sampled-action log-probabilities weighted by a reward or advantage signal."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Gradient de politique"
        },
        {
          "@language": "en",
          "@value": "Policy gradient"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/score-function",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/mathematical-tools-geometry"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Gradient du logarithme de la probabilité d'une action ou d'un token sous une politique paramétrée ; à distinguer d'un score de compatibilité ou d'attention."
        },
        {
          "@language": "en",
          "@value": "Gradient of the log-probability of an action or token under a parameterized policy; distinct from a compatibility or attention score."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Fonction score"
        },
        {
          "@language": "en",
          "@value": "Score function"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/off-policy-reinforcement-learning",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/inference-efficiency"
        }
      ],
      "llmlab:importance": "specialized",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Apprentissage à partir de trajectoires produites par une politique de comportement qui peut différer de la politique dont on calcule la mise à jour."
        },
        {
          "@language": "en",
          "@value": "Learning from trajectories generated by a behavior policy that may differ from the policy whose update is being computed."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Apprentissage par renforcement hors politique"
        },
        {
          "@language": "en",
          "@value": "Off-policy reinforcement learning"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/training-inference-mismatch",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/inference-efficiency"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Écart entre les distributions effectives du moteur qui échantillonne les trajectoires et du moteur qui calcule les mises à jour d'entraînement."
        },
        {
          "@language": "en",
          "@value": "Difference between the effective distributions of the engine sampling trajectories and the engine computing training updates."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Décalage entraînement-inférence"
        },
        {
          "@language": "en",
          "@value": "Training-inference mismatch"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/score-centering",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/inference-efficiency"
        }
      ],
      "llmlab:importance": "specialized",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Correction additive qui soustrait, à chaque préfixe, l'espérance sous le sampler du score de la politique entraînée afin d'annuler le terme de dérive identifié en apprentissage hors politique."
        },
        {
          "@language": "en",
          "@value": "Additive correction that subtracts, at each prefix, the sampler expectation of the trainer-policy score to cancel the identified drift term in off-policy learning."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Centrage du score"
        },
        {
          "@language": "en",
          "@value": "Score centering"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/importance-sampling",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Technique qui pondère les échantillons par un rapport de probabilités afin d'estimer une espérance associée à une distribution cible à partir d'échantillons issus d'une autre distribution."
        },
        {
          "@language": "en",
          "@value": "Technique that weights samples by a probability ratio to estimate an expectation under a target distribution from samples drawn from another distribution."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Échantillonnage par importance"
        },
        {
          "@language": "en",
          "@value": "Importance sampling"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/next-concept-modeling",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/inference-efficiency"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Cadre de génération non autorégressive qui représente une séquence par une hiérarchie de codes discrets et prédit ces codes niveau par niveau, de grossier à fin, avec parallélisme à l'intérieur de chaque niveau."
        },
        {
          "@language": "en",
          "@value": "Non-autoregressive generation framework that represents a sequence as a hierarchy of discrete codes and predicts those codes level by level, coarse to fine, with parallelism within each level."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Next-Concept Modeling (NCM)"
        },
        {
          "@language": "en",
          "@value": "Next-Concept Modeling (NCM)"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/hierarchical-discrete-codes",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/mathematical-tools-geometry"
        }
      ],
      "llmlab:importance": "specialized",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Représentation d'une séquence par plusieurs niveaux de codes discrets, les niveaux ultérieurs ajoutant des détails à la reconstruction fournie par les précédents."
        },
        {
          "@language": "en",
          "@value": "Representation of a sequence through multiple levels of discrete codes, with later levels adding detail to the reconstruction supplied by earlier ones."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Codes discrets hiérarchiques"
        },
        {
          "@language": "en",
          "@value": "Hierarchical discrete codes"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/coarse-to-fine-generation",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/inference-efficiency"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Stratégie qui génère d'abord une représentation grossière, puis la raffine par étapes successives ; dans NCM, les codes d'un même niveau sont prédits en parallèle."
        },
        {
          "@language": "en",
          "@value": "Strategy that first generates a coarse representation and then refines it through successive stages; in NCM, codes within one level are predicted in parallel."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Génération du grossier au fin"
        },
        {
          "@language": "en",
          "@value": "Coarse-to-fine generation"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/multiscale-residual-vector-quantization",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/mathematical-tools-geometry"
        }
      ],
      "llmlab:importance": "specialized",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Procédé de tokenisation appris qui encode une séquence en plusieurs niveaux de codes discrets résiduels, chaque niveau apportant une information de reconstruction supplémentaire."
        },
        {
          "@language": "en",
          "@value": "Learned tokenization procedure that encodes a sequence into multiple levels of residual discrete codes, each level adding further reconstruction information."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Quantification vectorielle résiduelle multi-échelle"
        },
        {
          "@language": "en",
          "@value": "Multiscale residual vector quantization"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/joint-embedding-predictive-architecture",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/mathematical-tools-geometry"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Famille d'architectures qui apprend des représentations en prédisant l'embedding d'une observation déclarée liée, sous une contrainte anti-effondrement qui empêche tous les embeddings de devenir identiques."
        },
        {
          "@language": "en",
          "@value": "Family of architectures that learns representations by predicting the embedding of a declared-related observation, under an anti-collapse constraint that prevents all embeddings from becoming identical."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Architecture à plongements joints prédictifs (JEPA)"
        },
        {
          "@language": "en",
          "@value": "Joint-Embedding Predictive Architecture (JEPA)"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/positive-pair-distribution",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/mathematical-tools-geometry"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Distribution des paires d'observations qu'un objectif d'entraînement déclare liées ; lue géométriquement, elle définit un graphe pondéré sur les observations."
        },
        {
          "@language": "en",
          "@value": "Distribution of observation pairs that a training objective declares related; read geometrically, it defines a weighted graph over observations."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Distribution de paires positives"
        },
        {
          "@language": "en",
          "@value": "Positive-pair distribution"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/platonic-representation-hypothesis",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/scale-research"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/mathematical-tools-geometry"
        }
      ],
      "llmlab:importance": "specialized",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Conjecture selon laquelle les représentations internes de modèles entraînés sur des modalités ou architectures différentes se ressemblent de plus en plus à mesure que les modèles et les données gagnent en échelle ; un théorème conditionnel la rend précise pour les JEPA dont les paires positives partagent les mêmes relations d'états du monde."
        },
        {
          "@language": "en",
          "@value": "Conjecture that internal representations of models trained on different modalities or architectures increasingly resemble each other as models and data scale; a conditional theorem makes it precise for JEPAs whose positive pairs share the same world-state relations."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Hypothèse de représentation platonique"
        },
        {
          "@language": "en",
          "@value": "Platonic Representation Hypothesis"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/laplacian-eigenmaps",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/mathematical-tools-geometry"
        }
      ],
      "llmlab:importance": "specialized",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Méthode d'apprentissage de variété qui attribue des coordonnées aux sommets d'un graphe pondéré en minimisant l'énergie de Dirichlet, de sorte que les sommets fortement reliés reçoivent des coordonnées proches ; la solution est portée par les premiers vecteurs propres du laplacien normalisé du graphe."
        },
        {
          "@language": "en",
          "@value": "Manifold-learning method that assigns coordinates to the vertices of a weighted graph by minimizing the Dirichlet energy, so that strongly connected vertices receive nearby coordinates; the solution is carried by the leading eigenvectors of the normalized graph Laplacian."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Cartes propres laplaciennes (Laplacian eigenmaps)"
        },
        {
          "@language": "en",
          "@value": "Laplacian eigenmaps"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/document-retrieval",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/inference-efficiency"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Sélection de documents ou de passages à partir d'une requête, au moyen de critères lexicaux, sémantiques, structurés ou hybrides."
        },
        {
          "@language": "en",
          "@value": "Selection of documents or passages from a query using lexical, semantic, structured, or hybrid criteria."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Récupération documentaire"
        },
        {
          "@language": "en",
          "@value": "Document retrieval"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/retrieval-augmented-generation",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/inference-efficiency"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Architecture qui récupère des informations externes puis les rend disponibles à un modèle génératif, généralement en les intégrant à son contexte."
        },
        {
          "@language": "en",
          "@value": "Architecture that retrieves external information and makes it available to a generative model, usually by adding it to the model context."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Génération augmentée par récupération (RAG)"
        },
        {
          "@language": "en",
          "@value": "Retrieval-augmented generation (RAG)"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/persistent-memory",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/inference-efficiency"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Informations conservées par un système LLM entre plusieurs appels ou sessions afin d'être sélectionnées et réutilisées ultérieurement."
        },
        {
          "@language": "en",
          "@value": "Information retained by an LLM system across calls or sessions so it can be selected and reused later."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Mémoire persistante applicative"
        },
        {
          "@language": "en",
          "@value": "Persistent application memory"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/context-injection",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/inference-efficiency"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Opération par laquelle une application inclut une information sélectionnée dans l'entrée effectivement transmise au modèle."
        },
        {
          "@language": "en",
          "@value": "Operation by which an application includes selected information in the input actually supplied to the model."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Injection dans le contexte"
        },
        {
          "@language": "en",
          "@value": "Context injection"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/surprisal",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Quantité d'information associée à un événement observé, égale à l'opposé du logarithme de sa probabilité."
        },
        {
          "@language": "en",
          "@value": "Information associated with an observed event, equal to the negative logarithm of its probability."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Surprise informationnelle"
        },
        {
          "@language": "en",
          "@value": "Surprisal"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/predictive-compression",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Codage d'une séquence en exploitant les probabilités conditionnelles d'un modèle pour attribuer des longueurs de code adaptées à la prévisibilité des événements."
        },
        {
          "@language": "en",
          "@value": "Coding a sequence using a model's conditional probabilities to assign code lengths according to how predictable events are."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Compression prédictive"
        },
        {
          "@language": "en",
          "@value": "Predictive compression"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/minimum-description-length",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/mathematical-tools-geometry"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Principe de sélection et d'évaluation qui considère le coût total de description d'un modèle et des données conditionnellement à ce modèle : L(M) + L(D|M), relativement à un langage de description et à un protocole de codage."
        },
        {
          "@language": "en",
          "@value": "Model-selection and evaluation principle that considers the total description cost of a model and the data conditional on that model: L(M) + L(D|M), relative to a description language and coding protocol."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Longueur minimale de description (MDL)"
        },
        {
          "@language": "en",
          "@value": "Minimum description length (MDL)"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/entropy-coding",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Famille de méthodes qui convertissent une distribution de probabilités en codes dont la longueur moyenne approche la limite informationnelle, avec décodage compatible."
        },
        {
          "@language": "en",
          "@value": "Family of methods that convert a probability distribution into codes whose average length approaches the information limit, with a compatible decoder."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Codage entropique"
        },
        {
          "@language": "en",
          "@value": "Entropy coding"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/arithmetic-coding",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Méthode de codage entropique qui représente une séquence entière par un intervalle numérique progressivement resserré selon les probabilités conditionnelles des symboles."
        },
        {
          "@language": "en",
          "@value": "Entropy-coding method that represents an entire sequence by a numerical interval progressively narrowed according to symbols' conditional probabilities."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Codage arithmétique"
        },
        {
          "@language": "en",
          "@value": "Arithmetic coding"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/model-compression",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/inference-efficiency"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Ensemble de transformations visant à réduire le coût de stockage ou d'exécution d'un modèle, avec un compromis possible sur la qualité."
        },
        {
          "@language": "en",
          "@value": "Set of transformations intended to reduce a model's storage or execution cost, potentially trading off quality."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Compression du modèle"
        },
        {
          "@language": "en",
          "@value": "Model compression"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/pruning",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/inference-efficiency"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Suppression de poids ou de structures d'un modèle afin de réduire sa représentation ou son calcul, avec des gains dépendant notamment de la structure et du matériel."
        },
        {
          "@language": "en",
          "@value": "Removal of model weights or structures to reduce representation size or computation, with gains depending notably on structure and hardware."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Élagage des paramètres"
        },
        {
          "@language": "en",
          "@value": "Pruning"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/quantization",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/inference-efficiency"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Réduction de la précision numérique utilisée pour représenter les poids ou activations, afin de diminuer le stockage ou les coûts d'exécution."
        },
        {
          "@language": "en",
          "@value": "Reduction of the numerical precision used to represent weights or activations to lower storage or execution costs."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Quantification numérique"
        },
        {
          "@language": "en",
          "@value": "Quantization"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/knowledge-distillation",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/inference-efficiency"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Entraînement d'un modèle étudiant à reproduire certains comportements ou sorties d'un modèle enseignant."
        },
        {
          "@language": "en",
          "@value": "Training a student model to reproduce selected behaviours or outputs of a teacher model."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Distillation de connaissances"
        },
        {
          "@language": "en",
          "@value": "Knowledge distillation"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/entropy",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Information moyenne associée à une variable aléatoire, égale à l'espérance de son surprisal sous sa distribution."
        },
        {
          "@language": "en",
          "@value": "Average information associated with a random variable, equal to the expected surprisal under its distribution."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Entropie"
        },
        {
          "@language": "en",
          "@value": "Entropy"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/kl-divergence",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Mesure asymétrique de l'écart entre deux distributions, égale à l'espérance sous la distribution cible du logarithme du rapport entre les probabilités."
        },
        {
          "@language": "en",
          "@value": "Asymmetric measure of the discrepancy between two distributions, equal to the target-distribution expectation of the log probability ratio."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Divergence KL"
        },
        {
          "@language": "en",
          "@value": "KL divergence"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/mutual-information",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Quantité qui mesure la réduction de l'incertitude sur une variable lorsque l'autre est connue, définie à partir de leur distribution jointe."
        },
        {
          "@language": "en",
          "@value": "Quantity measuring the reduction in uncertainty about one variable when the other is known, defined from their joint distribution."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Information mutuelle"
        },
        {
          "@language": "en",
          "@value": "Mutual information"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/v-information",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        }
      ],
      "llmlab:importance": "specialized",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Gain de prédictibilité d'une variable cible apporté par une information latérale, mesuré relativement à une famille explicitement définie de prédicteurs et à une perte logarithmique ; sa valeur dépend donc de la classe de modèles considérée."
        },
        {
          "@language": "en",
          "@value": "Gain in predictability of a target variable from side information, measured relative to an explicitly specified family of predictors and logarithmic loss; its value therefore depends on the model class considered."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "V-information prédictive"
        },
        {
          "@language": "en",
          "@value": "Predictive V-information"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/kolmogorov-complexity",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/mathematical-tools-geometry"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "specialized",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Longueur du plus court programme, sur une machine universelle de référence, qui produit un objet donné ; elle est définie à une constante additive près selon la machine, mais n'est pas calculable en général."
        },
        {
          "@language": "en",
          "@value": "Length of the shortest program, on a reference universal machine, that produces a given object; it is defined up to an additive machine-dependent constant but is not computable in general."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Complexité de Kolmogorov"
        },
        {
          "@language": "en",
          "@value": "Kolmogorov complexity"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/algorithmic-probability",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/mathematical-tools-geometry"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "specialized",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Somme des poids 2^{-longueur(programme)} des programmes préfixes d'une machine universelle qui produisent un préfixe donné ; elle définit une semi-mesure universelle, semi-calculable par le bas mais pas calculable exactement."
        },
        {
          "@language": "en",
          "@value": "Sum of the 2^{-program-length} weights of prefix-free programs on a universal machine that produce an output beginning with a given string; it defines a universal semimeasure that is lower semicomputable but not exactly computable."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Probabilité algorithmique"
        },
        {
          "@language": "en",
          "@value": "Algorithmic probability"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/solomonoff-induction",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/mathematical-tools-geometry"
        }
      ],
      "llmlab:importance": "specialized",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Prédiction séquentielle fondée sur la semi-mesure algorithmique universelle ; elle bénéficie de garanties de convergence sous des hypothèses formelles, mais la semi-mesure ne peut pas être calculée exactement."
        },
        {
          "@language": "en",
          "@value": "Sequential prediction based on the universal algorithmic semimeasure; it has formal convergence guarantees under stated assumptions, but the semimeasure cannot be computed exactly."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Induction de Solomonoff"
        },
        {
          "@language": "en",
          "@value": "Solomonoff induction"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/sequential-decision-theory",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "specialized",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Cadre dans lequel un agent choisit des actions successives afin de maximiser une récompense future espérée, compte tenu de ses observations et d'un modèle de l'environnement."
        },
        {
          "@language": "en",
          "@value": "Framework in which an agent chooses successive actions to maximize expected future reward given its observations and a model of the environment."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Théorie de la décision séquentielle"
        },
        {
          "@language": "en",
          "@value": "Sequential decision theory"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/aixi",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "specialized",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Agent universel théorique qui combine le mélange universel sur les semi-mesures chronologiques énumérables avec la maximisation de récompense en décision séquentielle ; il est optimal dans un sens formel donné, mais incalculable."
        },
        {
          "@language": "en",
          "@value": "Theoretical universal agent combining the universal mixture over enumerable chronological semimeasures with reward maximization in sequential decision-making; it is optimal in a specified formal sense but incomputable."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "AIXI"
        },
        {
          "@language": "en",
          "@value": "AIXI"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/free-energy-principle",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "specialized",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Cadre théorique selon lequel les systèmes auto-organisés peuvent être décrits comme limitant une quantité de surprise à long terme via une borne variationnelle appelée énergie libre ; cette formulation dépend d'un modèle génératif et ne signifie pas que surprise, erreur de prédiction et énergie libre sont identiques."
        },
        {
          "@language": "en",
          "@value": "Theoretical framework in which self-organizing systems can be described as limiting long-run surprise through a variational bound called free energy; the formulation depends on a generative model and does not make surprise, prediction error, and free energy identical."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Principe de l'énergie libre (FEP)"
        },
        {
          "@language": "en",
          "@value": "Free Energy Principle (FEP)"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/active-inference",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "specialized",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Cadre de perception-action dans lequel un agent ajuste ses croyances et peut agir sur son environnement selon un modèle génératif et des états préférés, en minimisant une énergie libre attendue ; ce cadre ne se réduit ni à la maximisation d'une récompense au sens d'AIXI, ni à une simple compression de données."
        },
        {
          "@language": "en",
          "@value": "Perception-action framework in which an agent updates its beliefs and may act on its environment according to a generative model and preferred states, minimizing expected free energy; it is neither equivalent to AIXI-style reward maximization nor reducible to ordinary data compression."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Inférence active"
        },
        {
          "@language": "en",
          "@value": "Active inference"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/aixi-tl",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/mathematical-tools-geometry"
        }
      ],
      "llmlab:importance": "specialized",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Construction calculable sous contraintes qui compare des politiques candidates bornées en temps par cycle et en longueur de programme ; son coût reste exponentiel en la borne de longueur et son optimalité est relative à la classe et aux conditions de preuve retenues."
        },
        {
          "@language": "en",
          "@value": "Computable resource-bounded construction comparing candidate policies bounded in per-cycle time and program length; its cost remains exponential in the length bound and its optimality is relative to the selected class and proof conditions."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "AIXI(t,l)"
        },
        {
          "@language": "en",
          "@value": "AIXI(t,l)"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/resource-bounded-computation",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/mathematical-tools-geometry"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Analyse ou construction d'algorithmes en imposant des bornes explicites sur le temps d'exécution, la mémoire ou la longueur des programmes."
        },
        {
          "@language": "en",
          "@value": "Analysis or construction of algorithms under explicit bounds on execution time, memory, or program length."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Calcul sous contraintes de ressources"
        },
        {
          "@language": "en",
          "@value": "Resource-bounded computation"
        }
      ]
    },
