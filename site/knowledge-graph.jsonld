    {
      "@id": "https://jm-brun.github.io/llm-lab/fr/vraisemblance.html",
      "@type": [
        "schema:WebPage",
        "schema:LearningResource"
      ],
      "llmlab:editorialLevel": "core",
      "schema:about": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/concept/log-likelihood"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/concept/logarithm"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/concept/observed-target"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/concept/sequence-likelihood"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/concept/surprisal"
        }
      ],
      "schema:abstract": "Calculer la vraisemblance d'une séquence à partir des probabilités conditionnelles des tokens, transformer le produit en somme de log-probabilités et expliquer l'équivalence entre maximiser la log-vraisemblance et minimiser la log-vraisemblance négative pour des observations fixées.",
      "schema:description": "Définir la probabilité attribuée à une séquence de tokens observée pour des paramètres de modèle fixés, à partir de la factorisation autorégressive par règle de chaîne et de son logarithme ; distinguer vraisemblance de séquence et log-vraisemblance de l'incertitude prédictive locale, de l'entropie croisée comme mesure entre distributions cible et prédite, et de l'agrégation de la loss sur un jeu de données.",
      "schema:inLanguage": "fr",
      "schema:learningResourceType": "concept-lesson",
      "schema:name": "Vraisemblance et log-vraisemblance"
    },
