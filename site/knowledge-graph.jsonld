        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/concept/predictive-compression"
        }
      ],
      "schema:abstract": "Derive cross-entropy for a target distribution, recover negative log-probability for a one-hot target, and explain how token alignment and valid-target masking affect the quantity computed during autoregressive training.",
      "schema:description": "Define cross-entropy between a target distribution and the model's predicted distribution at a target position, including the one-hot case that reduces to token negative log-probability; distinguish it from the entropy of the prediction and from the batch-level loss reduction and masking policy.",
      "schema:inLanguage": "en",
      "schema:learningResourceType": "concept-lesson",
      "schema:name": "Cross-entropy: the token-prediction objective"
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/en/decoding-strategies.html",
      "@type": [
        "schema:WebPage",
        "schema:LearningResource"
      ],
      "llmlab:editorialLevel": "advanced",
      "schema:about": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/concept/decoding-policy"
        }
      ],
      "schema:abstract": "Readers should be able to distinguish distribution transformations from sequence search, explain temperature/top-k/top-p, analyze why likelihood maximization is insufficient for open-ended text quality, and document a decoding protocol.",
      "schema:description": "Studies transformations applied to next-token distributions and sequence-search methods: temperature, top-k, nucleus sampling, greedy/beam search, and contrastive decoding; discusses quality-diversity trade-offs and reproducibility requirements.",
      "schema:inLanguage": "en",
      "schema:learningResourceType": "deep-dive",
      "schema:name": "Advanced decoding strategies"
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/en/embedding-space.html",
      "@type": [
        "schema:WebPage",
