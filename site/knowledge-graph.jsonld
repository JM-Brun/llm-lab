          "@value": "Token"
        },
        {
          "@language": "en",
          "@value": "Token"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/token-embedding",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/text-tokenization"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/mathematical-tools-geometry"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Vecteur obtenu par consultation de la matrice de plongements à partir de l’identifiant du token."
        },
        {
          "@language": "en",
          "@value": "Vector retrieved from the embedding matrix using the token ID."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Plongement initial du token"
        },
        {
          "@language": "en",
          "@value": "Initial token embedding"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/contextualized-representation",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/mathematical-tools-geometry"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "État vectoriel dont la valeur dépend du token, de son contexte et des calculs du réseau."
        },
        {
          "@language": "en",
          "@value": "Vector state whose value depends on the token, its context, and the network computation."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Représentation contextualisée"
        },
        {
          "@language": "en",
          "@value": "Contextualized representation"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/query",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/mathematical-tools-geometry"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Projection qui encode ce qu’une position cherche à récupérer dans les autres positions."
        },
        {
          "@language": "en",
          "@value": "Projection encoding what a position seeks to retrieve from other positions."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Query (requête)"
        },
        {
          "@language": "en",
          "@value": "Query"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/key",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/mathematical-tools-geometry"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Projection qui rend une position adressable par les requêtes des autres positions."
        },
        {
          "@language": "en",
          "@value": "Projection that makes a position addressable by queries from other positions."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Key (clé)"
        },
        {
          "@language": "en",
          "@value": "Key"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/value",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/mathematical-tools-geometry"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Projection porteuse de l’information agrégée selon les poids d’attention."
        },
        {
          "@language": "en",
          "@value": "Projection carrying the information aggregated according to attention weights."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Value (valeur)"
        },
        {
          "@language": "en",
          "@value": "Value"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/self-attention",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Mécanisme qui calcule des poids entre positions d’une même séquence et agrège leurs valeurs."
        },
        {
          "@language": "en",
          "@value": "Mechanism that computes weights between positions in one sequence and aggregates their values."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Auto-attention"
        },
        {
          "@language": "en",
          "@value": "Self-attention"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/attention-score",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/mathematical-tools-geometry"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Score de compatibilité calculé entre une requête et une clé avant sa conversion en poids d'attention normalisés."
        },
        {
          "@language": "en",
          "@value": "Compatibility score computed between a query and a key before conversion into normalized attention weights."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Score d'attention"
        },
        {
          "@language": "en",
          "@value": "Attention score"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/attention-weight",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/mathematical-tools-geometry"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Coefficient normalisé, après prise en compte du masque éventuel, qui pondère la contribution d'une valeur à une sortie d'attention."
        },
        {
          "@language": "en",
          "@value": "Normalized coefficient, after any applicable mask, that weights a value's contribution to an attention output."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Poids d'attention"
        },
        {
          "@language": "en",
          "@value": "Attention weight"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/scaled-dot-product-attention",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/mathematical-tools-geometry"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Mécanisme qui calcule des scores par produit scalaire entre requêtes et clés, les met à l'échelle, les normalise et agrège les vecteurs de valeur."
        },
        {
          "@language": "en",
          "@value": "Mechanism that computes query–key dot-product scores, scales and normalizes them, and aggregates value vectors."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Attention à produit scalaire mise à l'échelle"
        },
        {
          "@language": "en",
          "@value": "Scaled dot-product attention"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/multi-head-attention",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Mécanisme qui exécute plusieurs calculs d'attention avec des projections propres à chaque tête, puis combine leurs sorties par concaténation et projection."
        },
        {
          "@language": "en",
          "@value": "Mechanism that runs multiple attention computations with per-head projections, then combines their outputs through concatenation and projection."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Attention multi-têtes"
        },
        {
          "@language": "en",
          "@value": "Multi-head attention"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/causal-mask",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Contrainte qui empêche une position de prendre en compte les positions futures."
        },
        {
          "@language": "en",
          "@value": "Constraint preventing a position from attending to future positions."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Masque causal"
        },
        {
          "@language": "en",
          "@value": "Causal mask"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/attention-mask",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Contrainte qui détermine quelles positions clés peuvent contribuer à la représentation calculée pour chaque position requête."
        },
        {
          "@language": "en",
          "@value": "Constraint determining which key positions may contribute to the representation computed for each query position."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Masque d'attention"
        },
        {
          "@language": "en",
          "@value": "Attention mask"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/padding-mask",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "core",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Masque d'attention qui empêche les positions de padding d'être utilisées comme contexte lorsqu'elles ne sont pas admissibles."
        },
        {
          "@language": "en",
          "@value": "Attention mask that prevents padding positions from being used as context when they are not admissible."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Masque de padding"
        },
        {
          "@language": "en",
          "@value": "Padding mask"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/document-boundary-mask",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        },
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/probabilistic-foundations-training"
        }
      ],
      "llmlab:importance": "supporting",
      "skos:definition": [
        {
          "@language": "fr",
          "@value": "Masque d'attention qui contrôle si les positions appartenant à des documents différents peuvent interagir dans une séquence packée."
        },
        {
          "@language": "en",
          "@value": "Attention mask that controls whether positions from different documents may interact within a packed sequence."
        }
      ],
      "skos:inScheme": {
        "@id": "https://jm-brun.github.io/llm-lab/id/scheme/concepts"
      },
      "skos:prefLabel": [
        {
          "@language": "fr",
          "@value": "Masque de frontière documentaire"
        },
        {
          "@language": "en",
          "@value": "Document-boundary mask"
        }
      ]
    },
    {
      "@id": "https://jm-brun.github.io/llm-lab/id/concept/positional-encoding",
      "@type": "skos:Concept",
      "dcterms:subject": [
        {
          "@id": "https://jm-brun.github.io/llm-lab/id/domain/architectures-mechanisms"
        },
        {
